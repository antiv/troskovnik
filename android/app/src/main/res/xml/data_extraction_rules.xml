<?xml version="1.0" encoding="utf-8"?>
<!--
  Pravila za API 31+ (android:dataExtractionRules). Isti razlog kao u
  backup_rules.xml: bez Keystore ključa vraćena baza je nečitljiva, pa je iz
  oba toka (cloud backup i direktan prenos na novi uređaj) izostavljamo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter" />
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
    </device-transfer>
</data-extraction-rules>
