# Šablon za upload na Google Play (deploy.sh --upload). Kopiraj u
# `android/deploy.env` i popuni. `android/deploy.env` i JSON ključ NIKAD ne idu u git!

# JSON ključ servisnog naloga (čuvaj VAN repo-a, npr. ~/keys/). Jednokratno:
#   1) Google Cloud Console → APIs & Services → uključi "Google Play Android Developer API"
#   2) IAM & Admin → Service Accounts → Create → Keys → Add key → JSON
#   3) Play Console → Users and permissions → Invite user (email servisnog naloga)
#      → dodeli aplikaciju + dozvolu "Release to testing tracks"
PLAY_SERVICE_ACCOUNT_JSON=/Users/ivanantonijevic/development/gen-lang-client-0285046248-dc5ad62138b6.json

# Track na koji ide bundle: internal | alpha | beta | production. Podrazumevano internal.
PLAY_TRACK=internal

